# =============================================================================
# ¿Con Cuál Pago? UY — Configuración de Entorno (100% Free Tier / $0 Cost)
# Copiá este archivo a `.env` y colocá tu clave gratuita de Google AI Studio.
# =============================================================================

# Google AI Studio Free Tier API Key (15 RPM / 1,500 RPD gratis)
GEMINI_API_KEY="YOUR_GOOGLE_AI_STUDIO_FREE_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Smart Quota Guard Limits (Cero Costo garantizado)
MAX_LLM_CALLS_PER_RUN="40"
MIN_LLM_DELAY_MS="4500"

# Over-The-Air (OTA) Live Catalog URL (GitHub Raw JSON actualizado por GitHub Actions)
VITE_REMOTE_DB_URL="https://raw.githubusercontent.com/michellereboledo/con-cual-pago-uy/main/public/deep-scrape-db.json"
