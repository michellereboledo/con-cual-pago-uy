{
  "name": "con-cual-pago-uy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "graphify": "node scripts/graphify-ast.cjs",
    "audit:discounts": "node scripts/audit-discounts.cjs",
    "audit:ponytail": "node scripts/ponytail-audit.cjs",
    "check:fast": "node scripts/graphify-ast.cjs && node scripts/audit-discounts.cjs && node scripts/ponytail-audit.cjs",
    "check:task": "node scripts/build-preview.cjs && node scripts/ponytail-audit.cjs",
    "check:full": "node scripts/graphify-ast.cjs && node scripts/build-preview.cjs && node scripts/ponytail-audit.cjs && node scripts/build-apk.cjs && node --experimental-websocket scripts/android-test-runner.cjs",
    "start:verifier": "node scripts/live-bank-verifier-server.cjs",
    "test:android": "node --experimental-websocket scripts/android-test-runner.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.2",
    "vite": "^5.4.11"
  }
}
